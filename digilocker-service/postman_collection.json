{
  "info": {
    "name": "DigiLocker Service API",
    "description": "Complete API collection for DigiLocker Authorization Microservice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "user123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "DigiLocker",
      "item": [
        {
          "name": "Get Issued Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/digilocker/documents/issued?userId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["digilocker", "documents", "issued"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Get Uploaded Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/digilocker/documents/uploaded?userId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["digilocker", "documents", "uploaded"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Download Document",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/digilocker/documents/download/:uri?userId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["digilocker", "documents", "download", ":uri"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ],
              "variable": [
                {
                  "key": "uri",
                  "value": "sample-document-uri"
                }
              ]
            }
          }
        },
        {
          "name": "Create UserDigiLocker",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"clientId\": \"sample_client_id\",\n  \"clientSecret\": \"sample_client_secret\",\n  \"accessToken\": \"sample_access_token\",\n  \"refreshToken\": \"sample_refresh_token\",\n  \"expiresIn\": 3600\n}"
            },
            "url": {
              "raw": "{{base_url}}/digilocker/user",
              "host": ["{{base_url}}"],
              "path": ["digilocker", "user"]
            }
          }
        },
        {
          "name": "Get UserDigiLocker",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/digilocker/user?userId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["digilocker", "user"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Delete UserDigiLocker",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/digilocker/user?userId={{userId}}",
              "host": ["{{base_url}}"],
              "path": ["digilocker", "user"],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
